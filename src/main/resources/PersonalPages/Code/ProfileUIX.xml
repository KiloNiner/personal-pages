<xwikidoc version="1.5" reference="PersonalPages.Code.ProfileUIX" locale="">
  <web>PersonalPages.Code</web>
  <name>ProfileUIX</name>
  <language/>
  <defaultLanguage/>
  <translation>0</translation>
  <creator>xwiki:XWiki.Admin</creator>
  <parent>PersonalPages.Code.WebHome</parent>
  <author>xwiki:XWiki.Admin</author>
  <contentAuthor>xwiki:XWiki.Admin</contentAuthor>
  <version>1.1</version>
  <title>Personal pages section of the user profile</title>
  <comment/>
  <minorEdit>false</minorEdit>
  <syntaxId>xwiki/2.1</syntaxId>
  <hidden>true</hidden>
  <content/>
  <object>
    <name>PersonalPages.Code.ProfileUIX</name>
    <number>0</number>
    <className>XWiki.UIExtensionClass</className>
    <property>
      <async_cached>0</async_cached>
    </property>
    <property>
      <async_context/>
    </property>
    <property>
      <async_enabled>0</async_enabled>
    </property>
    <property>
      <content>{{include reference="PersonalPages.Code.Macros"/}}

{{velocity}}
(% id="HPersonalPages" %)
== $services.localization.render('personalpages.profile.title') ==

#set ($profileUserRef = $doc.documentReference)
#set ($isOwnProfile = $xcontext.userReference == $profileUserRef)
#ppFindPages($profileUserRef)
#if ($ppFound &amp;&amp; $services.security.authorization.hasAccess('view', $ppFound))
  #ppLink($ppFound)
  $ppLink

  {{documentTree root="document:$services.rendering.escape($services.model.serialize($ppFound, 'default'), 'xwiki/2.1')" showRoot="false" /}}
#elseif ($isOwnProfile)
  $services.localization.render('personalpages.profile.noneOwn', ["[[$services.localization.render('personalpages.hub.create')&gt;&gt;doc:PersonalPages.WebHome]]"])
#else
  $services.localization.render('personalpages.profile.none')
#end
{{/velocity}}</content>
    </property>
    <property>
      <extensionPointId>org.xwiki.plaftorm.user.profile.menu</extensionPointId>
    </property>
    <property>
      <name>org.xwiki.contrib.personalpages.profile</name>
    </property>
    <property>
      <parameters>icon=home
name=$services.localization.render('personalpages.profile.menu')
priority=900</parameters>
    </property>
    <property>
      <scope>wiki</scope>
    </property>
  </object>
</xwikidoc>
