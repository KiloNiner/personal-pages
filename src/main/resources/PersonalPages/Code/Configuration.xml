{{info}}$services.localization.render('personalpages.admin.appliesToNew'){{/info}}

## Result of the last batch of the bulk creation (the batches run on PersonalPages.WebHome, see there).
#set ($bulkResult = $NULL)
#if ("$!request.bulkProcessed" != '')
  #set ($bulkProcessed = $numbertool.toNumber($request.bulkProcessed).intValue())
  #set ($bulkTotal = $numbertool.toNumber($request.bulkTotal).intValue())
  #set ($bulkDone = $bulkProcessed &gt;= $bulkTotal)
  #set ($bulkResult = {'processed': $bulkProcessed, 'total': $bulkTotal, 'created': "$!request.bulkCreated", 'existing': "$!request.bulkExisting", 'blocked': "$!request.bulkBlocked", 'done': $bulkDone})
#end
{{html clean="false"}}
&lt;h2&gt;$escapetool.xml($services.localization.render('personalpages.admin.bulk.title'))&lt;/h2&gt;
&lt;p&gt;$escapetool.xml($services.localization.render('personalpages.admin.bulk.hint'))&lt;/p&gt;
#if ($bulkResult)
  &lt;div class="box #if ($bulkResult.done)successmessage#{else}infomessage#end" id="personalPagesBulkResult"
    data-processed="$bulkResult.processed" data-total="$bulkResult.total" data-created="$escapetool.xml($bulkResult.created)"
    data-existing="$escapetool.xml($bulkResult.existing)" data-done="$bulkResult.done"&gt;
    $escapetool.xml($services.localization.render('personalpages.admin.bulk.progress', [$bulkResult.processed, $bulkResult.total, $bulkResult.created, $bulkResult.existing]))
    #if ($bulkResult.blocked != '')
      &lt;br/&gt;$escapetool.xml($services.localization.render('personalpages.admin.bulk.blocked', [$bulkResult.blocked]))
    #end
  &lt;/div&gt;
#end
&lt;form method="post" action="$escapetool.xml($xwiki.getURL('PersonalPages.WebHome'))" id="personalPagesBulkForm"&gt;
  &lt;input type="hidden" name="form_token" value="$escapetool.xml($services.csrf.token)"/&gt;
  &lt;input type="hidden" name="action" value="createAll"/&gt;
  &lt;input type="hidden" name="start" value="#if ($bulkResult &amp;&amp; !$bulkResult.done)$bulkResult.processed#{else}0#end"/&gt;
  #if ($bulkResult &amp;&amp; !$bulkResult.done)
  &lt;input type="hidden" name="created" value="$escapetool.xml($bulkResult.created)"/&gt;
  &lt;input type="hidden" name="existing" value="$escapetool.xml($bulkResult.existing)"/&gt;
  #end
  &lt;p&gt;&lt;input type="submit" class="btn btn-default" value="$escapetool.xml($services.localization.render('personalpages.admin.bulk.button'))"/&gt;&lt;/p&gt;
&lt;/form&gt;
#if ($bulkResult &amp;&amp; !$bulkResult.done)
  ## Continue with the next batch automatically.
  &lt;script&gt;document.getElementById('personalPagesBulkForm').submit();&lt;/script&gt;
#end
{{/html}}
{{/velocity}}</codeToExecute>
